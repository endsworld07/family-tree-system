<section class="applicant-section">

    <h2 class="section-title">

        一、申請人資料

    </h2>

    <div class="applicant-grid">

        <div class="form-item">

            <label for="applicant">

                申請人姓名

            </label>

            <input
                id="applicant"
                name="applicant"
                type="text"
                autocomplete="off"
                value="{{ applicant|default('') }}">

        </div>


        <div class="form-item">

            <label for="id_number">

                身分證字號

            </label>

            <input
                id="id_number"
                name="id_number"
                type="text"
                autocomplete="off"
                value="{{ id_number|default('') }}">

        </div>


        <div class="form-item">

            <label for="birthday">

                出生日期

            </label>

            <input
                id="birthday"
                name="birthday"
                type="date"
                value="{{ birthday|default('') }}">

        </div>


        <div class="form-item">

            <label for="gender">

                性別

            </label>

            <select
                id="gender"
                name="gender">

                <option value=""
                    {% if gender|default('')=='' %}
                    selected
                    {% endif %}>
                </option>

                <option value="男"
                    {% if gender|default('')=='男' %}
                    selected
                    {% endif %}>
                    男
                </option>

                <option value="女"
                    {% if gender|default('')=='女' %}
                    selected
                    {% endif %}>
                    女
                </option>

            </select>

        </div>


        <div class="form-item full-width">

            <label for="address">

                戶籍地址

            </label>

            <input
                id="address"
                name="address"
                type="text"
                autocomplete="off"
                value="{{ address|default('') }}">

        </div>


        <div class="form-item full-width">

            <label for="phone">

                聯絡電話

            </label>

            <input
                id="phone"
                name="phone"
                type="text"
                autocomplete="off"
                value="{{ phone|default('') }}">

        </div>


        <div class="form-item full-width">

            <label for="purpose">

                申請用途

            </label>

            <input
                id="purpose"
                name="purpose"
                type="text"
                autocomplete="off"
                value="{{ purpose|default('') }}"
                placeholder="請輸入申請用途">

        </div>

    </div>

</section>